{
  "name": "nila-markdown",
  "version": "0.1.0",
  "description": "ویرایشگر و نمایشگرِ Markdown با پیش‌نمایشِ زنده، درختِ سلسله‌مراتب و مارک‌های سفارشی",
  "keywords": [
    "markdown",
    "editor",
    "viewer",
    "react",
    "rtl",
    "persian",
    "typescript"
  ],
  "author": {
    "name": "Mohammad Ali Nikoei",
    "email": "m.nikoie2005@gmail.com"
  },
  "homepage": "https://github.com/mnikoie/NilaMarkdown-Editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnikoie/NilaMarkdown-Editor.git",
    "directory": "packages/markdown"
  },
  "bugs": {
    "url": "https://github.com/mnikoie/NilaMarkdown-Editor/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "dev": "tailwindcss -i src/styles/index.css -o dist/styles.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "bench": "vitest run --config vitest.perf.config.ts",
    "conformance": "pnpm build && node scripts/conformance.mjs",
    "vendor:themes": "node scripts/vendor-themes.mjs"
  },
  "dependencies": {
    "decode-named-character-reference": "^1.3.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-markdown": "^2.1.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "peerDependencies": {
    "katex": "^0.18.4",
    "mermaid": "^11.17.0",
    "react": ">=18",
    "react-dom": ">=18",
    "shiki": "^4.4.3",
    "lucide-react": ">=1"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "lucide-react": "^1.33.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
